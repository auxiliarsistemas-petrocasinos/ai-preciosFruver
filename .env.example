# Application
APP_NAME=ai-preciosFruver
APP_ENV=development
DEBUG=true
APP_ORIGIN=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=28800

# SESSION_COOKIE_SECURE=false solo es válido para HTTP en localhost/127.0.0.1/::1.
# Todo acceso desde otro equipo requiere APP_ORIGIN=https://... y SESSION_COOKIE_SECURE=true.

# Web server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (development values only; replace them outside local development)
POSTGRES_DB=ai_precios_fruver
POSTGRES_USER=ai_precios_fruver
POSTGRES_PASSWORD=change-me
# URL para ejecutar la aplicación o Alembic directamente desde WSL.
# Docker Compose configura su propia URL con el host interno `db`.
DATABASE_URL=postgresql+psycopg://ai_precios_fruver:change-me@localhost:5432/ai_precios_fruver
POSTGRES_PORT=5432

# Ruta usada al ejecutar la aplicación directamente. Docker Compose fija y monta
# /var/lib/ai-precios-fruver/evidence tanto para la aplicación como para evidence_data.
EVIDENCE_STORAGE_PATH=/var/lib/ai-precios-fruver/evidence
