# Application
APP_NAME=ai-preciosFruver
APP_ENV=development
DEBUG=true

# Web server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (development values only; replace them outside local development)
POSTGRES_DB=ai_precios_fruver
POSTGRES_USER=ai_precios_fruver
POSTGRES_PASSWORD=change-me
# URL para ejecutar la aplicación o Alembic directamente desde WSL.
# Docker Compose configura su propia URL con el host interno `db`.
DATABASE_URL=postgresql+psycopg://ai_precios_fruver:change-me@localhost:5432/ai_precios_fruver
POSTGRES_PORT=5432

# Persistent evidence storage mount point inside the application container.
EVIDENCE_STORAGE_PATH=/var/lib/ai-precios-fruver/evidence
